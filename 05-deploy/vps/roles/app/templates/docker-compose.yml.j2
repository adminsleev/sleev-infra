# Managed by Ansible — do not edit by hand.
# Re-generated on every deploy run.
services:
  app:
    image: "{{ ghcr_image }}:{{ image_tag }}"
    container_name: "app_{{ env }}"
    restart: unless-stopped
    network_mode: host
    environment:
      - PORT={{ app_port }}
    env_file:
      - .env
