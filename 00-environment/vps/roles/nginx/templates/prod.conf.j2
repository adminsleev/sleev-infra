# {{ ansible_managed }}
server {
    listen 80;
    server_name {{ nginx_prod_primary_domain }} {{ nginx_prod_alt_domain }};
    return 301 https://{{ nginx_prod_primary_domain }}$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ nginx_prod_alt_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ nginx_prod_primary_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_prod_primary_domain }}/privkey.pem;

    return 301 https://{{ nginx_prod_primary_domain }}$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ nginx_prod_primary_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ nginx_prod_primary_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_prod_primary_domain }}/privkey.pem;

    gzip on;
    gzip_types text/html application/json text/css application/javascript;

    client_max_body_size {{ nginx_client_max_body_size }};

    location / {
        proxy_pass         http://127.0.0.1:{{ nginx_prod_upstream_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }
}
