# secrets — block everything, whitelist only SOPS-encrypted files and the SOPS config
90-secrets/*
!90-secrets/.gitkeep
!90-secrets/.sops.yaml
!90-secrets/*.enc.yaml.tpl
/tmp/

# Ansible
*.retry
provision/.tmp_vars_*.yml
.ansible_facts_cache/
.ansible/
# bootstrap group_vars holds real IPs at run-time — never commit
inventories/bootstrap/group_vars/all.yml

# direnv
.direnv/

# OS
.DS_Store
